{
  "name": "vitest-gwt",
  "version": "4.0.0",
  "description": "A small library to help Vitest support given-when-then style testing without a bunch of overhead",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "!**/*.spec.ts"
  ],
  "scripts": {
    "build": "wireit",
    "test": "wireit",
    "lint": "wireit",
    "test:coverage": "wireit",
    "prepublishOnly": "wireit"
  },
  "wireit": {
    "build": {
      "command": "tsc --project ./tsconfig.build.json",
      "files": [
        "src/**/*.ts",
        "tsconfig.*",
        "!src/**/*.spec.ts"
      ],
      "output": [
        "lib/**"
      ]
    },
    "lint": {
      "command": "eslint ./src"
    },
    "test": {
      "command": "vitest run"
    },
    "test:coverage": {
      "command": "vitest run --coverage"
    },
    "prepublishOnly": {
      "dependencies": [
        "lint",
        "test:coverage",
        "build"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devzeebo/vitest-gwt.git"
  },
  "peerDependencies": {
    "vitest": ">=4.0.0"
  },
  "keywords": [
    "vitest",
    "gwt",
    "unit",
    "testing",
    "given",
    "when",
    "then"
  ],
  "author": "Eric Siebeneich",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/devzeebo/vitest-gwt/issues"
  },
  "homepage": "https://github.com/devzeebo/vitest-gwt#readme",
  "devDependencies": {
    "@react-ddd/eslint-config": "^0.4.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "axios": "^1.17.0",
    "lodash": "^4.18.1",
    "typescript": "^6.0.3",
    "vitest": ">=4.1.8",
    "wireit": "^0.14.12"
  },
  "dependencies": {
    "gwt-runner": "^2.4.0"
  }
}